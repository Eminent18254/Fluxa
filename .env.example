# ============================================================
# FLUXA — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# ---- Coston2 network ----
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_CHAIN_ID=114

# ---- Deployer key (testnet only — use a throwaway wallet) ----
# Fund with C2FLR from https://faucet.flare.network/coston2
PRIVATE_KEY=

# ---- Contract verification (Coston2 Blockscout) ----
# Blockscout on Coston2 does not require a real key; any placeholder works.
FLARE_EXPLORER_API_KEY=placeholder

# ---- FDC (Flare Data Connector) ----
# Required for the cross-chain XRPL payment rail.
# Without this the verifier returns HTTP 401. Request from Flare.
VERIFIER_API_KEY_TESTNET=
COSTON2_VERIFIER_URL_TESTNET=https://fdc-verifiers-testnet.flare.network/
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network/

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Frontend (Vite only exposes VITE_* to the client) ----
VITE_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_INVOICE_REGISTRY_ADDRESS=
VITE_SETTLEMENT_VAULT_ADDRESS=

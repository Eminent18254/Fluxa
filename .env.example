# Fluxa environment.
#
# There is one network (GenLayer Studionet) and one datastore (SQLite).
# No hosted database, no service keys, no third-party credentials.

# ---- Deployment (server-side only, used by the GenLayer CLI) ----
GENLAYER_ACCOUNT=
GENLAYER_PRIVATE_KEY=
GENLAYER_OBLIGATION_CONTRACT=0x4Cb20B9dD428F2B14bf4d256a1342a4cC39a5cEE

# ---- SQLite projection API (api/) ----
# Where the mirror database lives. Created on first run.
FLUXA_DB_PATH=api/data/fluxa.sqlite
# The port the read-only projection API listens on.
PORT=8787

# ---- Frontend (Vite exposes only VITE_* variables) ----
VITE_GENLAYER_OBLIGATION_CONTRACT=0x4Cb20B9dD428F2B14bf4d256a1342a4cC39a5cEE
VITE_FLUXA_API_URL=http://localhost:8787

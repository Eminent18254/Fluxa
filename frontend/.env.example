# Fluxa frontend environment.
#
# The only contract address the browser needs. Leave it blank to fall back to
# the address compiled into src/config/genlayer.ts.
VITE_GENLAYER_OBLIGATION_CONTRACT=0x9eBE9664a68faA688FB95F058c30763a25846b79

# Optional: the local SQLite projection API. The app reads the contract for
# everything that matters, so this is only used for mirrored queries.
VITE_FLUXA_API_URL=http://localhost:8787
